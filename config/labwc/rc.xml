<?xml version="1.0"?>
<labwc_config>
  <core><gap>6</gap></core>
  <desktops number="8">
    <names>
      <name>&#xf0ca0;</name>
      <name>&#xf0ca2;</name>
      <name>&#xf0ca4;</name>
      <name>&#xf0ca6;</name>
      <name>&#xf0ca8;</name>
      <name>&#xf0caa;</name>
      <name>&#xf0cac;</name>
      <name>&#xf0cae;</name>
    </names>
  </desktops>
  <theme>
    <name>CatppuccinFrappe</name>
    <cornerRadius>8</cornerRadius>
    <font place="ActiveWindow"><name>Inter</name><size>10</size></font>
    <font place="InactiveWindow"><name>Inter</name><size>10</size></font>
  </theme>
  <keyboard>
    <!-- Launcher / terminal -->
    <keybind key="W-space"><action name="Execute" command="fuzzel"/></keybind>
    <keybind key="A-space"><action name="Execute" command="fuzzel"/></keybind>
    <keybind key="W-Return"><action name="Execute" command="foot"/></keybind>

    <!-- Window management (Super = Cmd) -->
    <keybind key="W-q"><action name="Close"/></keybind>
    <keybind key="W-m"><action name="Iconify"/></keybind>
    <keybind key="W-h"><action name="Iconify"/></keybind>
    <keybind key="W-Tab"><action name="NextWindow"/></keybind>
    <keybind key="W-S-Tab"><action name="PreviousWindow"/></keybind>
    <keybind key="A-Tab"><action name="NextWindow"/></keybind>
    <keybind key="A-S-Tab"><action name="PreviousWindow"/></keybind>
    <keybind key="W-grave"><action name="NextWindow"/></keybind>
    <keybind key="W-Up"><action name="ToggleMaximize"/></keybind>
    <keybind key="W-Down"><action name="Iconify"/></keybind>
    <keybind key="W-Left"><action name="SnapToEdge" direction="left"/></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right"/></keybind>

    <!-- Workspaces (mac Spaces)
         `wsctl mark` mencatat workspace aktif untuk pager sfwbar. labwc tak
         punya IPC perintah, jadi pager tak bisa membaca desktop aktif sendiri;
         state di-track lewat sini + lewat klik di bar. Wajib berpasangan:
         tiap GoToDesktop harus diikuti mark dgn nomor sama, kalau tidak
         highlight di bar melenceng. -->
    <keybind key="W-1">
      <action name="GoToDesktop" to="1"/>
      <action name="Execute" command="~/.config/sfwbar/wsctl mark 1"/>
    </keybind>
    <keybind key="W-2">
      <action name="GoToDesktop" to="2"/>
      <action name="Execute" command="~/.config/sfwbar/wsctl mark 2"/>
    </keybind>
    <keybind key="W-3">
      <action name="GoToDesktop" to="3"/>
      <action name="Execute" command="~/.config/sfwbar/wsctl mark 3"/>
    </keybind>
    <keybind key="W-4">
      <action name="GoToDesktop" to="4"/>
      <action name="Execute" command="~/.config/sfwbar/wsctl mark 4"/>
    </keybind>
    <keybind key="W-5">
      <action name="GoToDesktop" to="5"/>
      <action name="Execute" command="~/.config/sfwbar/wsctl mark 5"/>
    </keybind>
    <keybind key="W-6">
      <action name="GoToDesktop" to="6"/>
      <action name="Execute" command="~/.config/sfwbar/wsctl mark 6"/>
    </keybind>
    <keybind key="W-7">
      <action name="GoToDesktop" to="7"/>
      <action name="Execute" command="~/.config/sfwbar/wsctl mark 7"/>
    </keybind>
    <keybind key="W-8">
      <action name="GoToDesktop" to="8"/>
      <action name="Execute" command="~/.config/sfwbar/wsctl mark 8"/>
    </keybind>
    <keybind key="C-W-Left"><action name="SendToDesktop" to="left"/></keybind>
    <keybind key="C-W-Right"><action name="SendToDesktop" to="right"/></keybind>

    <!-- Notifikasi (mako). Ctrl+Super dipakai supaya xremap meloloskannya —
         W-n / W-d polos sudah dimakan xremap jadi Ctrl+n / Ctrl+d. -->
    <keybind key="C-W-n"><action name="Execute" command="makoctl dismiss"/></keybind>
    <keybind key="C-W-S-n"><action name="Execute" command="makoctl dismiss --all"/></keybind>
    <keybind key="C-W-d"><action name="Execute" command="makoctl mode -t do-not-disturb"/></keybind>
    <keybind key="C-W-S-d"><action name="Execute" command="makoctl restore"/></keybind>

    <!-- Power menu (fuzzel). Ctrl+Super+Q dipakai karena W-q polos = Close.
         Sama di dwl (config.h) dan Hyprland (hyprland.conf). Log Out di dalam
         menu memakai `loginctl terminate-session`, bukan aksi Exit labwc —
         Exit hanya membunuh compositor, tak menutup sesi logind. -->
    <keybind key="C-W-q"><action name="Execute" command="~/.config/scripts/powermenu"/></keybind>

    <!-- Screenshots -->
    <keybind key="W-S-3">
      <action name="Execute" command='sh -c "grim ~/Pictures/shot-$(date +%s).png"'/>
    </keybind>
    <keybind key="W-S-4">
      <action name="Execute" command='sh -c "grim -g \"$(slurp)\" ~/Pictures/shot-$(date +%s).png"'/>
    </keybind>
    <!-- + Ctrl = ke clipboard (bukan file) -->
    <keybind key="C-W-S-3">
      <action name="Execute" command='sh -c "grim - | wl-copy -t image/png"'/>
    </keybind>
    <keybind key="C-W-S-4">
      <action name="Execute" command='sh -c "grim -g \"$(slurp)\" - | wl-copy -t image/png"'/>
    </keybind>
    <!-- Tombol PrtSc: default clipboard; + Ctrl = ke file -->
    <keybind key="Print">
      <action name="Execute" command='sh -c "grim - | wl-copy -t image/png"'/>
    </keybind>
    <keybind key="S-Print">
      <action name="Execute" command='sh -c "grim -g \"$(slurp)\" - | wl-copy -t image/png"'/>
    </keybind>
    <keybind key="C-Print">
      <action name="Execute" command='sh -c "grim ~/Pictures/shot-$(date +%s).png"'/>
    </keybind>
    <keybind key="C-S-Print">
      <action name="Execute" command='sh -c "grim -g \"$(slurp)\" ~/Pictures/shot-$(date +%s).png"'/>
    </keybind>

    <!-- Media keys — lewat wrapper scripts/ supaya ada OSD, bukan wpctl/
         brightnessctl langsung. Wrapper yang memanggil tool aslinya. -->
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="~/.config/scripts/volumectl up"/></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="~/.config/scripts/volumectl down"/></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="~/.config/scripts/volumectl mute"/></keybind>
    <keybind key="XF86AudioMicMute"><action name="Execute" command="~/.config/scripts/volumectl mic-mute"/></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="~/.config/scripts/brightctl up"/></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="~/.config/scripts/brightctl down"/></keybind>
  </keyboard>
  <mouse/>
</labwc_config>
