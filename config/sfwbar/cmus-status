#!/usr/bin/env python3
"""cmus-status — modul now-playing cmus untuk sfwbar.

cmus tak punya socket event untuk status pemutaran (beda dgn Hyprland), jadi
poll `cmus-remote -Q` tiap ~1 detik adalah jalur pragmatis — sama semangatnya
dgn poll 0.25s yg dipakai wsctl untuk state file. Kalau cmus tak terpasang atau
tak jalan, emit "[cmus off]" alih-alih crash — modul harus diam, bukan bikin
sfwbar error-loop.

    cmus-status watch   cetak {"label": "..."} tiap kali teks berubah (line-buffered)
"""

import json
import subprocess
import sys
import time


def read_status():
    try:
        out = subprocess.run(
            ["cmus-remote", "-Q"],
            capture_output=True, text=True, timeout=2,
        )
    except FileNotFoundError:
        return "[cmus off]"
    if out.returncode != 0:
        return "[cmus off]"

    status, artist, title = None, None, None
    for line in out.stdout.splitlines():
        if line.startswith("status "):
            status = line[len("status "):].strip()
        elif line.startswith("tag artist "):
            artist = line[len("tag artist "):].strip()
        elif line.startswith("tag title "):
            title = line[len("tag title "):].strip()

    if status is None:
        return "[cmus off]"
    if status == "stopped" or not (artist or title):
        return "[cmus stopped]"
    return "%s - %s" % (artist or "?", title or "?")


def emit(label, last=[None]):
    """Cetak hanya saat berubah — ExecClient sfwbar emit trigger tiap ada output."""
    if label == last[0]:
        return
    last[0] = label
    print(json.dumps({"label": label}), flush=True)


def watch():
    while True:
        emit(read_status())
        time.sleep(1)


def main():
    if len(sys.argv) < 2 or sys.argv[1] != "watch":
        sys.exit(__doc__)
    watch()


if __name__ == "__main__":
    main()
