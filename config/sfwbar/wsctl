#!/usr/bin/env python3
"""wsctl — baca & ganti workspace aktif Hyprland untuk sfwbar.

KENAPA ADA: widget `pager` bawaan sfwbar cuma punya backend sway IPC + Hyprland,
dan backend Hyprland-nya baca state sekali saat start lalu berhenti menyimak
event fokus (diuji di sfwbar 1.0~beta16: window pindah ke workspace 3, workspace
aktif 3, highlight tetap di 2). Man sfwbar juga bilang eksplisit "Placer and
pager require sway". Maka `pager` diganti tombol manual di sfwbar.config yang
memanggil script ini.

    wsctl watch    cetak {"ws": N} tiap workspace aktif berubah (line-buffered)
    wsctl set N    pindah ke workspace N
    wsctl mark N   no-op (dipertahankan demi kompatibilitas bentuk CLI; Hyprland
                   selalu query state live lewat IPC, jadi tak butuh state file)

Branch ini Hyprland-only (labwc/dwl dibuang bersama config-nya) — baca+tulis
penuh lewat IPC Hyprland (.socket2.sock untuk event, hyprctl untuk query/dispatch).
"""

import json
import os
import socket
import subprocess
import sys
import time

WS_COUNT = 8  # workspace 1-8 persistent, lihat hyprland.lua


def emit(ws, last=[None]):
    """Cetak hanya saat berubah — ExecClient sfwbar emit trigger tiap ada output."""
    if ws is None or ws == last[0]:
        return
    last[0] = ws
    print(json.dumps({"ws": ws}), flush=True)


def hypr_socket_dir():
    his = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not his:
        return None
    runtime = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
    # Hyprland >=0.40 pakai $XDG_RUNTIME_DIR/hypr, versi lama /tmp/hypr
    for base in (os.path.join(runtime, "hypr"), "/tmp/hypr"):
        path = os.path.join(base, his)
        if os.path.isdir(path):
            return path
    return None


def hypr_active():
    try:
        out = subprocess.run(
            ["hyprctl", "activeworkspace", "-j"],
            capture_output=True, text=True, timeout=2,
        ).stdout
        return int(json.loads(out)["id"])
    except Exception:
        return None


def hypr_watch():
    emit(hypr_active())
    sockdir = hypr_socket_dir()
    if not sockdir:
        sys.exit("wsctl: socket Hyprland tak ditemukan")
    # Event yg mengubah workspace aktif. `workspacev2` bawa id langsung, tapi
    # focusedmon/moveworkspace tidak — jadi selalu query ulang, murah.
    watched = (
        "workspace>>", "workspacev2>>", "focusedmon>>",
        "moveworkspace>>", "moveworkspacev2>>",
        "createworkspace>>", "destroyworkspace>>",
    )
    while True:
        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.connect(os.path.join(sockdir, ".socket2.sock"))
            with sock.makefile("r", buffering=1, errors="replace") as stream:
                for line in stream:
                    if line.startswith(watched):
                        emit(hypr_active())
        except OSError:
            # Compositor restart / socket hilang — coba lagi, jangan mati.
            time.sleep(1)


def hypr_set(ws):
    # `hyprctl dispatch` mengikuti FORMAT CONFIG instance-nya: instance ber-config
    # Lua (sesi ini) mem-parse argumen dispatch sebagai Lua
    # (`hyprctl dispatch workspace 2` -> "')' expected near '2'"). Bentuk lama
    # tetap dicoba sebagai cadangan kalau suatu saat sesi jalan dgn .conf lagi.
    lua = subprocess.run(
        ["hyprctl", "dispatch", "hl.dsp.focus({workspace=%d})" % int(ws)],
        capture_output=True, text=True,
    )
    if lua.returncode == 0 and "error" not in (lua.stdout or "").lower():
        return
    subprocess.run(["hyprctl", "dispatch", "workspace", str(ws)],
                   capture_output=True)


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    cmd = sys.argv[1]

    if cmd == "watch":
        hypr_watch()
        return

    if cmd in ("set", "mark"):
        if len(sys.argv) < 3:
            sys.exit("wsctl: %s butuh nomor workspace" % cmd)
        ws = int(sys.argv[2])
        if not 1 <= ws <= WS_COUNT:
            sys.exit("wsctl: workspace di luar 1-%d" % WS_COUNT)
        if cmd == "set":
            hypr_set(ws)
        return

    sys.exit(__doc__)


if __name__ == "__main__":
    main()
