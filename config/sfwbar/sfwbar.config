# sfwbar — top menu-bar ala macOS untuk labwc
# Bar tipis translucent gelap: kiri = menu + app, kanan = status + jam.
# Widget di-include dari /usr/share/sfwbar/*.widget (bawaan paket).

Set Term = "foot"

# Task switcher (Super+Tab dihandle labwc, ini fallback sfwbar)
switcher {
  interval = 700
  icons = true
  labels = false
  cols = 5
}

include("winops.widget")   # menu klik-kanan pada app di taskbar
include("cal.widget")      # popup kalender saat klik jam
include("cpu.source")      # var XCpuUtilization
include("memory.source")   # var XMemUtilization
include("swap.source")     # var SwapTotal / SwapUsed

layout {

  size = "100%"
  layer = "top"
  exclusive_zone = "auto"   # labwc reserve ruang, window tak ketiban bar
  mirror = "*"              # tampil di semua monitor

  # Tinggi bar ala macOS menu bar (~24px)
  css = "* { min-height: 24px; }"

  # --- KIRI: menu (Apple) + launcher app + app yang berjalan ---
  include("startmenu.widget")

  # Quick-launch (dock ala macOS)
  grid {
    style = "launchers"
    button {
      value = "zen-browser"
      tooltip = "Zen Browser"
      action = Exec "zen-browser"
    }
    button {
      value = "helium"
      tooltip = "Helium Browser"
      action = Exec "helium"
    }
    button {
      value = "vscode"
      tooltip = "VS Code"
      action = Exec "code"
    }
    button {
      value = "org.xfce.thunar"
      tooltip = "Thunar"
      action = Exec "thunar"
    }
    button {
      value = "/usr/share/icons/sourcegit.png"
      tooltip = "SourceGit"
      action = Exec "sourcegit"
    }
  }

  # Garis pemisah launcher | taskbar
  label {
    value = ""
    style = "sep"
  }

  taskbar {
    style = "taskbar"
    rows = 1
    icons = true
    labels = false          # macOS menu bar tak tampilkan label app
    sort = false
    action[3] = Menu "winops"
    action[Drag] = Focus
  }

  # Spacer dorong sisa widget ke kanan
  label {
    css = "* { -GtkWidget-hexpand: true; }"
  }

  # --- KANAN: workspace + status + jam ---
  pager {
    style = "pager"
    rows = 1
    pins = "󰲠","󰲢","󰲤","󰲦"
    preview = true
    action[Drag] = WorkspaceActivate
  }

  # CPU + RAM (teks %) — klik buka PopUp detail bawaan sfwbar
  label {
    value = "CPU " + Str(XCpuUtilization*100,0) + "%"
    style = "sysmon"
    interval = 1000
    tooltip = "Klik: detail sistem"
    action = PopUp "sysmon"
  }
  label {
    value = "RAM " + Str(XMemUtilization*100,0) + "%"
    style = "sysmon"
    interval = 1000
    tooltip = "Klik: detail sistem"
    action = PopUp "sysmon"
  }

  tray {
    rows = 1
  }

  include("network-module.widget")
  include("volume.widget")
  include("battery-svg.widget")

  # Jam + tanggal (klik = popup kalender)
  grid {
    css = "* { -GtkWidget-direction: bottom; }"
    action[0] = Function "XCalInit"
    action = Function "XCalPopUp"
    label {
      value = Time("%a %d %b  %H:%M")
      style = "clock"
    }
  }
}

# PopUp detail sistem (klik CPU/RAM di bar)
PopUp "sysmon" {
  AutoClose = true
  style = "sysmon_popup"

  grid {
    css = "* { -GtkWidget-direction: bottom; }"

    grid {
      label { value = "CPU"; style = "sm_name" }
      label {
        value = Str(XCpuUtilization*100,0) + "%"
        style = "sm_val"
        interval = 1000
      }
    }
    scale {
      value = XCpuUtilization
      interval = 1000
      style = "sm_bar_cpu"
    }

    grid {
      label { value = "RAM"; style = "sm_name" }
      label {
        value = Str(XMemUtilization*100,0) + "%"
        style = "sm_val"
        interval = 1000
      }
    }
    scale {
      value = XMemUtilization
      interval = 1000
      style = "sm_bar_mem"
    }

    grid {
      label { value = "Swap"; style = "sm_name" }
      label {
        value = Str(If(SwapTotal>0,SwapUsed/SwapTotal,0)*100,0) + "%"
        style = "sm_val"
        interval = 1000
      }
    }
    scale {
      value = If(SwapTotal>0,SwapUsed/SwapTotal,0)
      interval = 1000
      style = "sm_bar_swap"
    }
  }
}

#CSS
/* Catppuccin Frappé (accent: teal) — samakan dgn fuzzel
   base #303446  mantle #292c3c  surface0 #414559  surface1 #51576d
   surface2 #626880  overlay0 #737994  text #c6d0f5  subtext1 #b5bfe2
   subtext0 #a5adce  teal #81c8be  blue #8caaee  green #a6d189  yellow #e5c890 */

window {
  background-color: rgba(48, 52, 70, 0.85);   /* base */
}

* {
  color: #c6d0f5;                              /* text */
  font: 12px "Inter", "SF Pro Text", "Symbols Nerd Font", "Cantarell", sans-serif;
  -GtkWidget-vexpand: true;
}

#taskbar button,
#pager button,
button {
  min-height: 0px;
  padding: 0px 6px;
  margin: 2px 2px;
  border-radius: 6px;
  outline-style: none;
  box-shadow: none;
  background-image: none;
  border-image: none;
  border: none;
  background-color: transparent;
}

button:hover {
  background-color: rgba(115, 121, 148, 0.30); /* overlay0 */
}

#taskbar button:active,
#pager button.focused {
  background-color: rgba(129, 200, 190, 0.28); /* teal tint */
  color: #81c8be;                              /* teal */
}

#clock {
  padding: 0px 10px;
  font-weight: 500;
  color: #c6d0f5;
}

#launchers {
  padding: 0px 4px;
}

/* Pemisah vertikal launcher | taskbar */
#sep {
  min-width: 1px;
  min-height: 14px;
  margin: 5px 8px;
  background-color: rgba(115, 121, 148, 0.45); /* overlay0 */
}

#launchers button {
  padding: 0px 4px;
  margin: 2px 1px;
}

#launchers button image {
  min-width: 18px;
  min-height: 18px;
  -GtkWidget-icon-size: 18px;
}

tray {
  padding: 0px 6px;
}

#sysmon {
  padding: 0px 8px;
  font-feature-settings: "tnum";
  color: #b5bfe2;                              /* subtext1 */
}

#sysmon_popup {
  background-color: rgba(41, 44, 60, 0.96);    /* mantle */
  border: 1px solid rgba(129, 200, 190, 0.35); /* teal border */
  border-radius: 10px;
  padding: 12px 14px;
}

#sm_name {
  color: #a5adce;                              /* subtext0 */
  min-width: 46px;
  font-weight: 500;
}

#sm_val {
  color: #c6d0f5;                              /* text */
  font-feature-settings: "tnum";
  -GtkWidget-halign: end;
  -GtkWidget-hexpand: true;
}

#sm_bar_cpu progress,
#sm_bar_mem progress,
#sm_bar_swap progress {
  border-radius: 4px;
}

#sm_bar_cpu,
#sm_bar_mem,
#sm_bar_swap {
  min-width: 180px;
  min-height: 6px;
  margin: 3px 0px 10px 0px;
}

#sm_bar_cpu progress  { background-color: #8caaee; } /* blue */
#sm_bar_mem progress  { background-color: #a6d189; } /* green */
#sm_bar_swap progress { background-color: #e5c890; } /* yellow */

#sm_bar_cpu trough,
#sm_bar_mem trough,
#sm_bar_swap trough {
  background-color: rgba(98, 104, 128, 0.35);  /* surface2 */
  border-radius: 4px;
  min-height: 6px;
}
