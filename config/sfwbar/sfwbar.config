# sfwbar — bar teks-only ala polybar untuk Hyprland (Void Linux).
# Bar tipis translucent gelap: kiri = taskbar teks, kanan = workspace + status + jam.
# Widget di-include dari /usr/share/sfwbar/*.widget (bawaan paket).

Set Term = "foot"

# Task switcher (Super+Tab dihandle Hyprland/snappy-switcher, ini fallback sfwbar)
switcher {
  interval = 700
  icons = true
  labels = false
  cols = 5
}

# Sumber workspace aktif. Widget `pager` bawaan sfwbar TAK DIPAKAI: backend-nya
# cuma sway IPC + Hyprland, dan yg Hyprland baca state sekali saat start lalu
# berhenti menyimak event fokus (man sfwbar: "Placer and pager require sway").
# Jadi workspace dibaca lewat wsctl, yg emit {"ws": N} tiap ada perubahan →
# sfwbar emit trigger "ws".
scanner {
  # Dibungkus `sh -c` sebab ExecClient tak lewat shell — beda dgn action Exec —
  # jadi $HOME tak diekspansi kalau dipanggil langsung.
  ExecClient("sh -c 'exec $HOME/.config/sfwbar/wsctl watch'", "ws") {
    WsActive = Json(".ws")
  }
  ExecClient("sh -c 'exec $HOME/.config/sfwbar/cmus-status watch'", "music") {
    MusicLabel = Json(".label")
  }
}

include("winops.widget")   # menu klik-kanan pada app di taskbar
include("cal.widget")      # popup kalender saat klik jam
include("cpu.source")      # var XCpuUtilization
include("memory.source")   # var XMemUtilization
include("swap.source")     # var SwapTotal / SwapUsed

# volume-popup.widget TIDAK dipakai sbg widget utuh (itu versi ikon) — cuma
# diambil module load-nya (module("pulsectl"); module("alsactl")) supaya
# fungsi Volume()/VolumeInfo() tersedia utk label teks kustom di bawah.
include("volume-popup.widget")
module("network")          # NetInfo()/NetStat(), dipakai network.widget asli
include("battery.source")  # var Level, Discharging (dihitung sendiri oleh file ini)

layout {

  size = "100%"
  layer = "top"
  exclusive_zone = "auto"   # Hyprland reserve ruang, window tak ketiban bar
  mirror = "*"              # tampil di semua monitor

  # Tinggi bar ala macOS menu bar (~24px)
  css = "* { min-height: 24px; }"

  # --- KIRI: taskbar teks (bukan ikon — ala polybar) ---
  taskbar {
    style = "taskbar"
    rows = 1
    icons = false
    labels = true           # judul window sbg teks, bukan ikon app
    sort = false
    action[3] = Menu "winops"
    action[Drag] = Focus
  }

  # Spacer dorong sisa widget ke kanan
  label {
    css = "* { -GtkWidget-hexpand: true; }"
  }

  # --- KANAN: workspace + status + jam ---
  # Pager manual. Label HARUS sama dgn Hyprland `default_name:` (hyprland.lua)
  # biar tampilan bar identik. style = expression → nama style ikut WsActive,
  # jadi highlight update tiap trigger "ws". Klik memanggil wsctl set N
  # (hyprctl dispatch).
  grid {
    style = "pager"
    label {
      value   = "I"
      style   = If(WsActive=1,"ws_on","ws_off")
      trigger = "ws"
      tooltip = "Workspace 1"
      action  = Exec "sh -c 'exec $HOME/.config/sfwbar/wsctl set 1'"
    }
    label {
      value   = "II"
      style   = If(WsActive=2,"ws_on","ws_off")
      trigger = "ws"
      tooltip = "Workspace 2"
      action  = Exec "sh -c 'exec $HOME/.config/sfwbar/wsctl set 2'"
    }
    label {
      value   = "III"
      style   = If(WsActive=3,"ws_on","ws_off")
      trigger = "ws"
      tooltip = "Workspace 3"
      action  = Exec "sh -c 'exec $HOME/.config/sfwbar/wsctl set 3'"
    }
    label {
      value   = "IV"
      style   = If(WsActive=4,"ws_on","ws_off")
      trigger = "ws"
      tooltip = "Workspace 4"
      action  = Exec "sh -c 'exec $HOME/.config/sfwbar/wsctl set 4'"
    }
    label {
      value   = "V"
      style   = If(WsActive=5,"ws_on","ws_off")
      trigger = "ws"
      tooltip = "Workspace 5"
      action  = Exec "sh -c 'exec $HOME/.config/sfwbar/wsctl set 5'"
    }
    label {
      value   = "VI"
      style   = If(WsActive=6,"ws_on","ws_off")
      trigger = "ws"
      tooltip = "Workspace 6"
      action  = Exec "sh -c 'exec $HOME/.config/sfwbar/wsctl set 6'"
    }
    label {
      value   = "VII"
      style   = If(WsActive=7,"ws_on","ws_off")
      trigger = "ws"
      tooltip = "Workspace 7"
      action  = Exec "sh -c 'exec $HOME/.config/sfwbar/wsctl set 7'"
    }
    label {
      value   = "VIII"
      style   = If(WsActive=8,"ws_on","ws_off")
      trigger = "ws"
      tooltip = "Workspace 8"
      action  = Exec "sh -c 'exec $HOME/.config/sfwbar/wsctl set 8'"
    }
  }

  label { value = " - "; style = "sep_txt" }

  # Now-playing cmus. MusicLabel kosong/"[cmus off]" saat cmus tak jalan —
  # lihat config/sfwbar/cmus-status.
  label {
    value   = MusicLabel
    style   = "status"
    trigger = "music"
    tooltip = "cmus"
  }

  label { value = " - "; style = "sep_txt" }

  # CPU + RAM (teks %) — klik buka PopUp detail bawaan sfwbar
  label {
    value = "CPU " + Str(XCpuUtilization*100,0) + "%"
    style = "status"
    interval = 1000
    tooltip = "Klik: detail sistem"
    action = PopUp "sysmon"
  }
  label { value = " - "; style = "sep_txt" }
  label {
    value = "RAM " + Str(XMemUtilization*100,0) + "%"
    style = "status"
    interval = 1000
    tooltip = "Klik: detail sistem"
    action = PopUp "sysmon"
  }

  label { value = " - "; style = "sep_txt" }

  tray {
    rows = 1
  }

  # Volume/Net/Battery — API asli diverifikasi langsung dari
  # /usr/share/sfwbar/{volume-popup,network,battery.source}.widget setelah
  # sfwbar benar2 terpasang (bukan ditebak): Volume()/VolumeInfo() sbg FUNGSI
  # (bukan var XVolume), NetInfo()/NetStat() (bukan var NetStatus), dan
  # Level/Discharging dari battery.source (bukan var XBatCapacity).
  label {
    value   = "Vol " + Str(Volume("sink-volume"),0) + "%" +
              If(Volume("sink-mute")," (mute)","")
    style   = "status"
    interval = 1000
  }
  label { value = " - "; style = "sep_txt" }
  label {
    value   = "Net: " + If(NetInfo("interface")=na() | NetInfo("interface")="",
                "offline",
                If(NetInfo("essid")="", NetInfo("interface"), NetInfo("essid")))
    style   = "status"
    interval = 5000
  }
  label { value = " - "; style = "sep_txt" }
  label {
    # action[0] = panggil sekali saat label dibuat, sama pola dgn XCalInit di
    # jam. Tanpa ini XBatteryState/Level tak pernah terisi.
    action[0] = XBatteryInit()
    value   = If(!Ident($XBatteryState), "",
                "Bat " + Str(Level,0) + "%" + If(Discharging,""," (charging)"))
    style   = If(!Ident($XBatteryState), "hidden", "status")
    interval = 5000
  }

  label { value = " - "; style = "sep_txt" }

  # Jam + tanggal (klik = popup kalender)
  grid {
    css = "* { -GtkWidget-direction: bottom; }"
    action[0] = Function "XCalInit"
    action = Function "XCalPopUp"
    label {
      value = Time("%a %d %b  %H:%M")
      style = "clock"
    }
  }

  # Power menu — WAJIB `label`, BUKAN `button`: `value` pada button diartikan
  # sebagai nama ikon, jadi glyph nerd-font akan muncul sebagai ikon fallback
  # "sfw". Sama seperti label pager di atas. Satu glyph tunggal dipertahankan
  # (bukan "[Power]" teks) — "Symbols Nerd Font" sudah jadi dependensi wajib
  # script powermenu ini sendiri.
  # `Exec` TIDAK lewat shell (sfwbar 1.0~beta16.1 fork+execvp argv hasil parse,
  # tak ada string "/bin/sh" di binernya) — `$HOME` telan mentah dan spawn gagal
  # DIAM-DIAM: klik tak melakukan apa pun, nol pesan error. Wajib bungkus
  # `sh -c '...'`, sama seperti ExecClient di scanner.
  label {
    value   = "󰐥"
    style   = "power_btn"
    tooltip = "Power (Ctrl+Cmd+Q)"
    action  = Exec "sh -c 'exec $HOME/.config/scripts/powermenu'"
  }
}

# PopUp detail sistem (klik CPU/RAM di bar)
PopUp "sysmon" {
  AutoClose = true
  style = "sysmon_popup"

  grid {
    css = "* { -GtkWidget-direction: bottom; }"

    grid {
      label { value = "CPU"; style = "sm_name" }
      label {
        value = Str(XCpuUtilization*100,0) + "%"
        style = "sm_val"
        interval = 1000
      }
    }
    scale {
      value = XCpuUtilization
      interval = 1000
      style = "sm_bar_cpu"
    }

    grid {
      label { value = "RAM"; style = "sm_name" }
      label {
        value = Str(XMemUtilization*100,0) + "%"
        style = "sm_val"
        interval = 1000
      }
    }
    scale {
      value = XMemUtilization
      interval = 1000
      style = "sm_bar_mem"
    }

    grid {
      label { value = "Swap"; style = "sm_name" }
      label {
        value = Str(If(SwapTotal>0,SwapUsed/SwapTotal,0)*100,0) + "%"
        style = "sm_val"
        interval = 1000
      }
    }
    scale {
      value = If(SwapTotal>0,SwapUsed/SwapTotal,0)
      interval = 1000
      style = "sm_bar_swap"
    }
  }
}

#CSS
/* Catppuccin Frappé (accent: teal) — samakan dgn fuzzel
   base #303446  mantle #292c3c  surface0 #414559  surface1 #51576d
   surface2 #626880  overlay0 #737994  text #c6d0f5  subtext1 #b5bfe2
   subtext0 #a5adce  teal #81c8be  blue #8caaee  green #a6d189  yellow #e5c890 */

window {
  background-color: rgba(48, 52, 70, 0.85);   /* base */
}

* {
  color: #c6d0f5;                              /* text */
  font: 14px "GohuFont", "Symbols Nerd Font", "Inter", "SF Pro Text", "Cantarell", sans-serif;
  -GtkWidget-vexpand: true;
}

#taskbar_item,
#ws_on,
#ws_off,
#power_btn,
button {
  min-height: 0px;
  padding: 0px 6px;
  margin: 2px 2px;
  border-radius: 6px;
  outline-style: none;
  box-shadow: none;
  background-image: none;
  border-image: none;
  border: none;
  background-color: transparent;
}

button:hover {
  background-color: rgba(115, 121, 148, 0.30); /* overlay0 */
}

/* Nama style sfwbar: tombol taskbar = #taskbar_item, class .active. BUKAN
   pseudo-class `:active` — itu state "sedang ditekan", bukan window aktif. */
#taskbar_item.active,
#ws_on {
  background-color: rgba(129, 200, 190, 0.28); /* teal tint */
  color: #81c8be;                              /* teal */
}

/* Tombol workspace tak aktif — sedikit redup dari teks biasa */
#ws_off {
  color: #a5adce;                              /* subtext0 */
}

#status {
  padding: 0px 4px;
  font-feature-settings: "tnum";
  color: #b5bfe2;                              /* subtext1 */
}

#sep_txt {
  padding: 0px 2px;
  color: #737994;                              /* overlay0 */
}

#clock {
  padding: 0px 10px;
  font-weight: 500;
  color: #c6d0f5;
}

/* Tombol power di ujung kanan. Redup saat idle, merah saat hover — sinyal
   "aksi merusak" tanpa perlu warna mencolok permanen di menu-bar.
   Glyph 󰐥 datang dari "Symbols Nerd Font" di font stack `*` di atas. */
#power_btn {
  padding: 0px 9px;
  color: #a5adce;                              /* subtext0 */
}

#power_btn:hover {
  background-color: rgba(231, 130, 132, 0.25); /* red tint */
  color: #e78284;                              /* red */
}

tray {
  padding: 0px 6px;
}

#sysmon_popup {
  background-color: rgba(41, 44, 60, 0.96);    /* mantle */
  border: 1px solid rgba(129, 200, 190, 0.35); /* teal border */
  border-radius: 10px;
  padding: 12px 14px;
}

#sm_name {
  color: #a5adce;                              /* subtext0 */
  min-width: 46px;
  font-weight: 500;
}

#sm_val {
  color: #c6d0f5;                              /* text */
  font-feature-settings: "tnum";
  -GtkWidget-halign: end;
  -GtkWidget-hexpand: true;
}

#sm_bar_cpu progress,
#sm_bar_mem progress,
#sm_bar_swap progress {
  border-radius: 4px;
}

#sm_bar_cpu,
#sm_bar_mem,
#sm_bar_swap {
  min-width: 180px;
  min-height: 6px;
  margin: 3px 0px 10px 0px;
}

#sm_bar_cpu progress  { background-color: #8caaee; } /* blue */
#sm_bar_mem progress  { background-color: #a6d189; } /* green */
#sm_bar_swap progress { background-color: #e5c890; } /* yellow */

#sm_bar_cpu trough,
#sm_bar_mem trough,
#sm_bar_swap trough {
  background-color: rgba(98, 104, 128, 0.35);  /* surface2 */
  border-radius: 4px;
  min-height: 6px;
}
